# SecureScan AI Server Configuration

# Server Port (Default: 5000)
PORT=5000

# JSON Web Token Secret Key (Change this in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Monitoring Cron Schedule (Default: every 15 minutes)
CRON_SCHEDULE="*/15 * * * *"

# PostgreSQL Configuration (Optional - embedded persistent database used by default if omitted)
# DATABASE_URL=postgresql://username:password@localhost:5432/securescan

# Or individual PostgreSQL parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_postgres_password
# PGDATABASE=securescan
# PGSSL=false
